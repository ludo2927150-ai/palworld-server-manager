{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palworld Server Manager",
  "version": "0.1.0",
  "identifier": "dev.palmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Palworld Server Manager", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/icon.ico"] }
}
